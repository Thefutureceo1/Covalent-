# ─── Clerk ─────────────────────────────────────────────────────────────────
# Vite requires VITE_ prefix (NOT NEXT_PUBLIC_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ─── PayPal ────────────────────────────────────────────────────────────────
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Subscription Plan IDs (PayPal Dashboard → Subscriptions → Plans)
VITE_PAYPAL_PLUS_MONTHLY_PLAN_ID=P-your_plus_monthly_plan_id
VITE_PAYPAL_PLUS_ANNUAL_PLAN_ID=P-your_plus_annual_plan_id
VITE_PAYPAL_PRO_MONTHLY_PLAN_ID=P-your_pro_monthly_plan_id
VITE_PAYPAL_PRO_ANNUAL_PLAN_ID=P-your_pro_annual_plan_id

# Pro Lifetime — PayPal NCP direct payment URL (not a subscription)
VITE_PAYPAL_PRO_LIFETIME_URL=https://www.paypal.com/ncp/payment/your_ncp_id
